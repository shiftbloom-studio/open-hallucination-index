# Open Hallucination Index — frontend environment
#
# Only NEXT_PUBLIC_* vars are needed; the frontend is a fully static export
# (output: 'export'). There is no server-side code in production.

# Public API base URL. In production the Worker serves the API on the same
# origin as the frontend.
NEXT_PUBLIC_API_BASE=https://ohi.example.com/api/v2

# Public site URL. Used for metadata, sitemap, OG image URLs.
NEXT_PUBLIC_SITE_URL=https://ohi.example.com

# Optional: when "true", shows a raw-JSON debug drawer on /verify.
NEXT_PUBLIC_SHOW_DEBUG=false

# Cloudflare Turnstile site key for the /verify form (public by design).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<your-turnstile-site-key>

# Operator details for the legal pages (Impressum, privacy, terms).
# Keep the real values in your deploy environment, not in the repository.
# NEXT_PUBLIC_OPERATOR_STUDIO=Example Studio
# NEXT_PUBLIC_OPERATOR_NAME=Jane Doe
# NEXT_PUBLIC_OPERATOR_STREET=Example Street 1
# NEXT_PUBLIC_OPERATOR_CITY=12345 Example Town
# NEXT_PUBLIC_OPERATOR_COUNTRY=Germany
# NEXT_PUBLIC_OPERATOR_EMAIL=hello@example.com

# ── Local dev ──
# To run against a local Worker (cd cloudflare/ohi-worker && pnpm run dev):
#   cp .env.example .env.local
# and then uncomment:
# NEXT_PUBLIC_API_BASE=http://localhost:8787/api/v2
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
